#!/bin/sh
set -eu
export PYTHONDONTWRITEBYTECODE=1
umask 077

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PROJECT_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
COMMAND=$(basename -- "$0")

case "$COMMAND" in
  personal-agent-tunnel)
    MODULE=personal_agent_remote.tunnel
    ;;
  personal-agent-tunnel-gateway)
    MODULE=personal_agent_remote.tunnel_gateway
    ;;
  personal-agent-tunnel-service)
    MODULE=personal_agent_remote.tunnel_service
    ;;
  *)
    echo '{"ok":false,"error":{"code":"unknown_gateway_launcher"}}' >&2
    exit 64
    ;;
esac

LOCK_DIGEST=$(shasum -a 256 "$PROJECT_ROOT/uv.lock" | awk '{print substr($1, 1, 16)}')
GATEWAY_PYTHON_ENV="${PERSONAL_AGENT_GATEWAY_PYTHON_ENV:-$HOME/Library/Caches/PersonalAgentToolkit/gateway-python/$LOCK_DIGEST}"
if [ -x "$GATEWAY_PYTHON_ENV/bin/python" ]; then
  PYTHONPATH="$PROJECT_ROOT/src${PYTHONPATH:+:$PYTHONPATH}" \
    exec "$GATEWAY_PYTHON_ENV/bin/python" -m "$MODULE" "$@"
fi

UV_BIN="${UV:-$(command -v uv || true)}"
if [ -z "$UV_BIN" ]; then
  echo '{"ok":false,"error":{"code":"runtime_missing","message":"uv is required to start the Personal Agent gateway."}}' >&2
  exit 127
fi

mkdir -p "$GATEWAY_PYTHON_ENV"
chmod 700 "$GATEWAY_PYTHON_ENV"

UV_PROJECT_ENVIRONMENT="$GATEWAY_PYTHON_ENV" \
  "$UV_BIN" sync \
    --project "$PROJECT_ROOT" \
    --frozen \
    --no-dev \
    --no-install-project \
    --quiet

PYTHONPATH="$PROJECT_ROOT/src${PYTHONPATH:+:$PYTHONPATH}" \
  exec "$GATEWAY_PYTHON_ENV/bin/python" -m "$MODULE" "$@"
