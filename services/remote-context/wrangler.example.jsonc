{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "personal-agent-context",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "STATE_DB",
      "database_name": "personal-agent-context",
      "database_id": "replace-with-d1-database-id",
      "migrations_dir": "migrations"
    },
    {
      "binding": "JOURNAL_DB",
      "database_name": "personal-agent-journal",
      "database_id": "replace-with-journal-d1-database-id"
    },
    {
      "binding": "LIBRARY_DB",
      "database_name": "personal-agent-library",
      "database_id": "replace-with-library-d1-database-id"
    },
    {
      "binding": "DESIGN_DB",
      "database_name": "personal-agent-design",
      "database_id": "replace-with-design-d1-database-id"
    }
  ],
  "r2_buckets": [
    {
      "binding": "LIBRARY_MEDIA",
      "bucket_name": "personal-agent-library-media"
    },
    {
      "binding": "DESIGN_ASSETS",
      "bucket_name": "personal-agent-design-assets"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "CORPUS_SHARDS", "class_name": "CorpusShard" },
      { "name": "SYNC_BROKERS", "class_name": "SyncBroker" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CorpusShard", "SyncBroker"]
    }
  ],
  "services": [
    {
      "binding": "AUTH_SERVICE",
      "service": "personal-agent-auth",
      "entrypoint": "AuthService"
    },
    {
      "binding": "DOCUMENT_ANALYZER",
      "service": "personal-agent-document-analyzer"
    }
  ],
  "vars": {
    "AUTH_ISSUER": "https://personal-agent-auth.example.workers.dev",
    "SENSE_RESOURCE": "https://personal-agent-context.example.workers.dev/sense/mcp",
    "CORPUS_RESOURCE": "https://personal-agent-context.example.workers.dev/corpus/mcp",
    "HYPES_RESOURCE": "https://personal-agent-context.example.workers.dev/hypes/mcp",
    "TOOLKIT_RESOURCE": "https://personal-agent-context.example.workers.dev/mcp",
    "STRUCTURE_PATH_COMPACTION_WRITE_ENABLED": "false",
    "SEARCH_INDEX_V2_WRITE_ENABLED": "false",
    "SEARCH_INDEX_V2_CUTOVER_ENABLED": "false"
  }
}
