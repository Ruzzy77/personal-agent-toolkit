{
  "name": "personal-agent-library-service",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "Owner-authenticated remote MCP for Library",
  "exports": {
    "./mcp": "./src/mcp.ts",
    "./service": "./src/service.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "migrate:sites": "node scripts/migrate-sites-storage.mjs",
    "deploy": "npm run check && wrangler deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@personal-agent/remote-runtime": "file:../../packages/remote-runtime",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.3",
    "@cloudflare/workers-types": "5.20260902.1",
    "@types/node": "26.4.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.128.0"
  },
  "engines": {
    "node": ">=24"
  }
}
