{
  "name": "personal-agent-auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Owner-operated OAuth service template for Personal Agent Toolkit resources",
  "scripts": {
    "test": "vitest run",
    "test:google": "vitest run --config vitest.google.config.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run test:google"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "0.10.3",
    "jose": "6.2.10"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.0.0",
    "@cloudflare/workers-types": "5.20260825.1",
    "@types/node": "26.3.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.125.0"
  },
  "engines": {
    "node": ">=24"
  }
}
