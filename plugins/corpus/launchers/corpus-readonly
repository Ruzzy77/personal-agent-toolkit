#!/bin/sh
set -eu
umask 077

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

deny() {
  printf '%s\n' \
    '{"ok":false,"error":{"code":"read_only_fallback_denied","message":"This launcher only permits the documented read-only fallback commands."}}' \
    >&2
  exit 64
}

command_name=
subcommand_name=
expect_data_root=false

for argument in "$@"; do
  if [ "$expect_data_root" = true ]; then
    [ -n "$argument" ] || deny
    expect_data_root=false
    continue
  fi

  if [ -z "$command_name" ]; then
    case "$argument" in
      --pretty)
        ;;
      --data-root)
        expect_data_root=true
        ;;
      --data-root=*)
        [ -n "${argument#--data-root=}" ] || deny
        ;;
      --*)
        deny
        ;;
      *)
        command_name=$argument
        ;;
    esac
    continue
  fi

  if [ -z "$subcommand_name" ]; then
    case "$command_name" in
      corpus|source|context)
        subcommand_name=$argument
        ;;
    esac
  fi
done

[ "$expect_data_root" = false ] || deny

case "$command_name:$subcommand_name" in
  corpus:list|overview:|status:|inventory:|search:|read:|source:list|source:fetch|context:list|context:show)
    ;;
  *)
    deny
    ;;
esac

exec "$SCRIPT_DIR/corpus" "$@"
