#!/bin/sh
set -eu
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export PYTHONDONTWRITEBYTECODE=1
umask 077

PLUGIN_LAUNCHER=$(/usr/bin/python3 - <<'PY'
import json
import re
from pathlib import Path

home = Path.home()
patterns = (
    ".codex/plugins/cache/*/corpus/*/launchers/corpus-maintenance",
    ".claude/plugins/cache/*/corpus/*/launchers/corpus-maintenance",
)


def version_key(path: Path) -> tuple[tuple[int, ...], int]:
    manifest_paths = (
        path.parents[1] / ".codex-plugin" / "plugin.json",
        path.parents[1] / ".claude-plugin" / "plugin.json",
    )
    version = "0"
    for manifest in manifest_paths:
        try:
            version = str(json.loads(manifest.read_text())["version"])
            break
        except (OSError, KeyError, TypeError, ValueError):
            pass
    numbers = tuple(int(value) for value in re.findall(r"\d+", version)[:6])
    try:
        modified = path.stat().st_mtime_ns
    except OSError:
        modified = 0
    return numbers, modified

candidates = {
    candidate.resolve()
    for pattern in patterns
    for candidate in home.glob(pattern)
    if candidate.is_file()
}
if candidates:
    print(max(candidates, key=version_key))
PY
)

if [ -z "$PLUGIN_LAUNCHER" ] || [ ! -x "$PLUGIN_LAUNCHER" ]; then
  echo "Corpus maintenance could not find an installed Corpus plugin." >&2
  exit 78
fi

exec "$PLUGIN_LAUNCHER"
