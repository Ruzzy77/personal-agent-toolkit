#!/bin/sh
set -eu
umask 077

case "${1-}" in
  read | status)
    ;;
  *)
    echo '{"ok":false,"error":{"code":"read_only_command_required","message":"sense-readonly permits only read and status."}}' >&2
    exit 64
    ;;
esac

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec "$SCRIPT_DIR/sense" "$@"
