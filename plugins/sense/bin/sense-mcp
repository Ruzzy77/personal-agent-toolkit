#!/bin/sh
set -eu
export PYTHONDONTWRITEBYTECODE=1
umask 077

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
PROJECT_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)

if [ -x "$PROJECT_ROOT/.venv/bin/python" ]; then
  PYTHONPATH="$PROJECT_ROOT/src${PYTHONPATH:+:$PYTHONPATH}" \
    exec "$PROJECT_ROOT/.venv/bin/python" -m sense.mcp_server
fi

UV_BIN="${UV:-$(command -v uv || true)}"
if [ -z "$UV_BIN" ]; then
  echo '{"ok":false,"error":{"code":"runtime_missing","message":"uv is required to start Sense."}}' >&2
  exit 127
fi

LOCK_DIGEST=$(shasum -a 256 "$PROJECT_ROOT/uv.lock" | awk '{print substr($1, 1, 16)}')
SENSE_PYTHON_ENV="${SENSE_PYTHON_ENV:-$HOME/Library/Caches/Sense/python-env/$LOCK_DIGEST}"
mkdir -p "$SENSE_PYTHON_ENV"
chmod 700 "$SENSE_PYTHON_ENV"

UV_PROJECT_ENVIRONMENT="$SENSE_PYTHON_ENV" \
  "$UV_BIN" sync \
    --project "$PROJECT_ROOT" \
    --frozen \
    --no-dev \
    --no-install-project \
    --quiet

PYTHONPATH="$PROJECT_ROOT/src${PYTHONPATH:+:$PYTHONPATH}" \
  exec "$SENSE_PYTHON_ENV/bin/python" -m sense.mcp_server
