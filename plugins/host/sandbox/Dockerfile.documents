# personal-agent-host-documents: baseline sandbox with the frozen Document Files runtime.
# build-sandbox.sh makes a minimal repository-shaped context before this build.
FROM personal-agent-host-sandbox:1
LABEL org.personal-agent.profile="documents" \
      org.personal-agent.features='["python","git","uv","ripgrep","document-files","docx","xlsx","pptx","pdf","image"]'

COPY scripts/document_files_release.py /build/scripts/document_files_release.py
COPY dependencies/document-files.json /build/dependencies/document-files.json
COPY plugins/document-files/pyproject.toml /build/plugins/document-files/pyproject.toml
COPY plugins/document-files/uv.lock /build/plugins/document-files/uv.lock
COPY plugins/document-files/src /build/plugins/document-files/src

RUN set -eux; \
    document_source="$(python3 /build/scripts/document_files_release.py source)"; \
    mkdir -p /opt/document-files; \
    cp -a "$document_source"/. /opt/document-files/; \
    cd /opt/document-files; \
    uv sync --locked --no-dev --no-cache; \
    ln -s /opt/document-files/.venv/bin/document-files /usr/local/bin/document-files; \
    ln -s /opt/document-files/.venv/bin/document-files-mcp /usr/local/bin/document-files-mcp; \
    document-files --help >/dev/null; \
    python=/opt/document-files/.venv/bin/python; \
    "$python" -c 'import document_files, docx, openpyxl, pptx, pypdf, PIL, reportlab'; \
    python3 --version; git --version; uv --version; rg --version; \
    rm -rf /build /root/.cache/uv

ENV PATH="/opt/document-files/.venv/bin:${PATH}"
WORKDIR /workspace
CMD ["/bin/sh"]
