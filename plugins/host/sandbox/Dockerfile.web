# personal-agent-host-web: baseline sandbox with the Node 24 web toolchain.
FROM node:24.21.0-bookworm-slim@sha256:2fe369e969550cde8e867afc3fe370b260140cab4a23d467074295b42163d553 AS node

FROM personal-agent-host-sandbox:1
LABEL org.personal-agent.profile="web" \
      org.personal-agent.features='["python","git","uv","ripgrep","node","npm"]'
COPY --from=node /usr/local /usr/local
# Check both the inherited runtime and the web additions.
RUN python3 --version && git --version && uv --version && rg --version \
 && node --version && npm --version
WORKDIR /workspace
CMD ["/bin/sh"]
