# Set these on the machine that runs Toolkit Flow.
TOOLKIT_FLOW_EXEC_HOST=registered-hostname
TOOLKIT_FLOW_WORKSPACE_ROOT=/path/to/registered/workspace
TOOLKIT_FLOW_DATA_DIR=/path/to/private/flow-data
TOOLKIT_FLOW_WORKSPACE_ID=workspace
TOOLKIT_FLOW_DISPLAY_NAME=작업공간
TOOLKIT_FLOW_PUBLIC_URL=http://127.0.0.1:4176
TOOLKIT_FLOW_PORT=4176

# Set for build/export only, to preserve the chosen standalone HTML filename.
TOOLKIT_FLOW_EXPORT_HTML=/path/to/toolkit-flow.html
