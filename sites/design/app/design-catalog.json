{
  "catalog_schema_version": 2,
  "library": {
    "schema_version": 1,
    "id": "personal-agent-design-library",
    "name": "Design Reference Library",
    "version": "0.1.0",
    "license": "Apache-2.0",
    "description": "제품과 콘텐츠의 맥락에 맞춰 조형 원리, 선택적 레시피와 재사용 자산을 찾는 디자인 참고 라이브러리",
    "source_title": "디자인 라이브러리"
  },
  "patterns": [
    {
      "id": "scan-and-select",
      "name": "탐색과 선택",
      "use_when": "여러 항목을 빠르게 훑고 비교하거나 한 항목을 선택해야 할 때",
      "principles": [
        "주요 항목과 다음 행동을 첫 화면에서 구분한다.",
        "반복되는 항목은 같은 정보 순서와 상태 표현을 사용한다.",
        "선택 상태는 색뿐 아니라 문구와 형태로 함께 표시한다."
      ],
      "checks": [
        "목록을 훑는 동안 항목의 차이와 현재 선택을 구분할 수 있는가",
        "키보드와 좁은 화면에서도 탐색과 선택 순서가 유지되는가"
      ]
    },
    {
      "id": "long-form-reading",
      "name": "장문 읽기",
      "use_when": "긴 본문을 편하게 읽고 원하는 절을 다시 찾아야 할 때",
      "principles": [
        "본문 측정폭과 줄 간격을 먼저 안정시킨다.",
        "목차와 절 표지는 위치를 찾는 데 필요한 정보만 제공한다.",
        "보조 내용은 본문 흐름을 끊지 않는 한 가지 표현 체계로 구분한다."
      ],
      "checks": [
        "긴 문단과 목록을 이어 읽을 때 시선이 불필요하게 흔들리지 않는가",
        "작은 화면과 인쇄에서도 제목, 본문과 보조 정보의 관계가 유지되는가"
      ]
    },
    {
      "id": "summary-and-evidence",
      "name": "요약과 자료 설명",
      "use_when": "주요 판단을 먼저 보여 주고 표, 그래프나 근거 자료를 이어 설명할 때",
      "principles": [
        "요약과 근거 자료의 순서를 분명하게 나눈다.",
        "수치, 표와 그래프를 설명 가까이에 둔다.",
        "색상 계열 외에도 라벨과 모양으로 자료를 구분한다."
      ],
      "checks": [
        "요약이 자료가 말하는 범위를 넘어서지 않는가",
        "단위, 범례와 자료 설명을 결과 가까이에서 확인할 수 있는가"
      ]
    },
    {
      "id": "structure-and-sequence",
      "name": "구조와 절차",
      "use_when": "구성 요소의 관계, 작업 순서나 기술 구조를 설명할 때",
      "principles": [
        "구획과 연결 방향만으로 전체 구조를 파악할 수 있게 한다.",
        "선, 번호와 강조색은 실제 관계나 주의 지점을 나타낼 때 사용한다.",
        "표와 도식의 제목, 단위와 캡션을 가까이 둔다."
      ],
      "checks": [
        "구성 요소와 연결 방향을 설명문 없이도 따라갈 수 있는가",
        "표와 도식이 좁은 화면에서 주변 레이아웃을 밀어내지 않는가"
      ]
    },
    {
      "id": "single-purpose",
      "name": "한 가지 목적",
      "use_when": "필수 정보와 한 가지 주요 행동에 집중해야 할 때",
      "principles": [
        "제목, 설명과 본문이 같은 내용을 되풀이하지 않게 한다.",
        "정보 위계는 먼저 크기, 정렬과 간격으로 만든다.",
        "카드, 배지와 구분선은 실제 경계나 상태가 있을 때만 사용한다."
      ],
      "checks": [
        "주요 행동과 실행 결과를 바로 이해할 수 있는가",
        "장식 요소를 빼도 내용과 상태가 분명한가"
      ]
    },
    {
      "id": "archive-reading",
      "name": "아카이브 읽기",
      "use_when": "발간물이나 연구 기록을 목록에서 골라 긴 내용으로 이동할 때",
      "principles": [
        "아카이브 이동, 발간 정보와 본문 읽기 도구의 역할을 분리한다.",
        "도입부의 메타데이터는 본문 제목과 되풀이하지 않는다.",
        "현재 위치와 읽기 설정은 본문보다 앞서지 않게 지속적으로 제공한다."
      ],
      "checks": [
        "목록과 본문 사이를 오갈 때 현재 발간물과 위치를 잃지 않는가",
        "발간 정보가 달라져도 제목과 본문의 시작선이 안정적으로 유지되는가"
      ]
    }
  ],
