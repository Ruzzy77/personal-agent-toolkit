{
  "name": "personal-agent-toolkit",
  "main": "vinext/server/app-router-entry",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "kv_namespaces": [
    {
      "binding": "WEB_SESSION_KV",
      "id": "3823f3894a4345078306e83141243002"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://personal-agent-toolkit.hiyaq77.workers.dev",
    "AUTH_ISSUER": "https://personal-agent-auth.hiyaq77.workers.dev",
    "CONTEXT_SERVICE_URL": "https://personal-agent-context.hiyaq77.workers.dev",
    "TOOLKIT_RESOURCE": "https://personal-agent-context.hiyaq77.workers.dev/mcp",
    "OAUTH_CLIENT_ID": "https://personal-agent-toolkit.hiyaq77.workers.dev/oauth-client.json"
  },
  "observability": {
    "enabled": false
  }
}
